{
  "branch_from": [
    {
      "source": "main",
      "source_ref": "refs/heads/main",
      "target": "dev",
      "target_ref": "refs/heads/dev",
      "target_ref_regex": "^refs/heads/dev$"
    },
    {
      "source": "dev",
      "source_ref": "refs/heads/dev",
      "target": "feat/*",
      "target_ref": "refs/heads/feat/*",
      "target_ref_regex": "^refs/heads/feat/.+$"
    },
    {
      "source": "main",
      "source_ref": "refs/heads/main",
      "target": "case/*/*",
      "target_ref": "refs/heads/case/*/*",
      "target_ref_regex": "^refs/heads/case/.+/.+$"
    },
    {
      "source": "dev",
      "source_ref": "refs/heads/dev",
      "target": "release/*",
      "target_ref": "refs/heads/release/*",
      "target_ref_regex": "^refs/heads/release/.+$"
    },
    {
      "source": "main",
      "source_ref": "refs/heads/main",
      "target": "hotfix/*",
      "target_ref": "refs/heads/hotfix/*",
      "target_ref_regex": "^refs/heads/hotfix/.+$"
    }
  ],
  "branches": {
    "families": [
      "feat/*",
      "case/*/*",
      "release/*",
      "hotfix/*"
    ],
    "long_lived": [
      "main",
      "dev"
    ]
  },
  "direct_commit_refs": [
    {
      "name": "case/*/*",
      "ref": "refs/heads/case/*/*",
      "ref_regex": "^refs/heads/case/.+/.+$"
    },
    {
      "name": "feat/*",
      "ref": "refs/heads/feat/*",
      "ref_regex": "^refs/heads/feat/.+$"
    },
    {
      "name": "release/*",
      "ref": "refs/heads/release/*",
      "ref_regex": "^refs/heads/release/.+$"
    },
    {
      "name": "hotfix/*",
      "ref": "refs/heads/hotfix/*",
      "ref_regex": "^refs/heads/hotfix/.+$"
    }
  ],
  "merge_rules": [
    {
      "id": "case/*/* to feat/*",
      "source": "case/*/*",
      "source_ref": "refs/heads/case/*/*",
      "source_ref_regex": "^refs/heads/case/.+/.+$",
      "target": "feat/*",
      "target_ref": "refs/heads/feat/*",
      "target_ref_regex": "^refs/heads/feat/.+$"
    },
    {
      "id": "dev to feat/*",
      "source": "dev",
      "source_ref": "refs/heads/dev",
      "source_ref_regex": "^refs/heads/dev$",
      "sync": true,
      "target": "feat/*",
      "target_ref": "refs/heads/feat/*",
      "target_ref_regex": "^refs/heads/feat/.+$"
    },
    {
      "id": "feat/* to dev",
      "source": "feat/*",
      "source_ref": "refs/heads/feat/*",
      "source_ref_regex": "^refs/heads/feat/.+$",
      "sync_merge_required": true,
      "target": "dev",
      "target_ref": "refs/heads/dev",
      "target_ref_regex": "^refs/heads/dev$"
    },
    {
      "id": "release/* to dev",
      "source": "release/*",
      "source_ref": "refs/heads/release/*",
      "source_ref_regex": "^refs/heads/release/.+$",
      "target": "dev",
      "target_ref": "refs/heads/dev",
      "target_ref_regex": "^refs/heads/dev$"
    },
    {
      "id": "release/* to main",
      "source": "release/*",
      "source_ref": "refs/heads/release/*",
      "source_ref_regex": "^refs/heads/release/.+$",
      "tag_pattern": "v#.#.0",
      "tag_ref": "refs/tags/v#.#.0",
      "tag_ref_regex": "^refs/tags/v[0-9]+\\.[0-9]+\\.0$",
      "tag_required": true,
      "tag_tokens": [
        "#",
        "#",
        "0"
      ],
      "target": "main",
      "target_ref": "refs/heads/main",
      "target_ref_regex": "^refs/heads/main$"
    },
    {
      "id": "hotfix/* to dev",
      "source": "hotfix/*",
      "source_ref": "refs/heads/hotfix/*",
      "source_ref_regex": "^refs/heads/hotfix/.+$",
      "target": "dev",
      "target_ref": "refs/heads/dev",
      "target_ref_regex": "^refs/heads/dev$"
    },
    {
      "id": "hotfix/* to main",
      "source": "hotfix/*",
      "source_ref": "refs/heads/hotfix/*",
      "source_ref_regex": "^refs/heads/hotfix/.+$",
      "tag_pattern": "v=.=.#",
      "tag_ref": "refs/tags/v=.=.#",
      "tag_ref_regex": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "tag_required": true,
      "tag_tokens": [
        "=",
        "=",
        "#"
      ],
      "target": "main",
      "target_ref": "refs/heads/main",
      "target_ref_regex": "^refs/heads/main$"
    }
  ],
  "protected_refs": [
    "refs/heads/dev",
    "refs/heads/main"
  ],
  "required_targets": [
    {
      "source": "case/*/*",
      "source_ref": "refs/heads/case/*/*",
      "source_ref_regex": "^refs/heads/case/.+/.+$",
      "target_refs": [
        "refs/heads/feat/*"
      ],
      "targets": [
        "feat/*"
      ]
    },
    {
      "source": "feat/*",
      "source_ref": "refs/heads/feat/*",
      "source_ref_regex": "^refs/heads/feat/.+$",
      "target_refs": [
        "refs/heads/dev"
      ],
      "targets": [
        "dev"
      ]
    },
    {
      "source": "release/*",
      "source_ref": "refs/heads/release/*",
      "source_ref_regex": "^refs/heads/release/.+$",
      "target_refs": [
        "refs/heads/dev",
        "refs/heads/main"
      ],
      "targets": [
        "dev",
        "main"
      ]
    },
    {
      "source": "hotfix/*",
      "source_ref": "refs/heads/hotfix/*",
      "source_ref_regex": "^refs/heads/hotfix/.+$",
      "target_refs": [
        "refs/heads/dev",
        "refs/heads/main"
      ],
      "targets": [
        "dev",
        "main"
      ]
    }
  ],
  "source": {
    "file": "contribution.md",
    "format": "mermaid.gitGraph",
    "path": ".git-guard/contribution.md"
  },
  "tag_rules": [
    {
      "source": "release/*",
      "tag_pattern": "v#.#.0",
      "tag_ref": "refs/tags/v#.#.0",
      "tag_ref_regex": "^refs/tags/v[0-9]+\\.[0-9]+\\.0$",
      "tag_required": true,
      "tag_tokens": [
        "#",
        "#",
        "0"
      ],
      "target": "main",
      "target_ref": "refs/heads/main"
    },
    {
      "source": "hotfix/*",
      "tag_pattern": "v=.=.#",
      "tag_ref": "refs/tags/v=.=.#",
      "tag_ref_regex": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "tag_required": true,
      "tag_tokens": [
        "=",
        "=",
        "#"
      ],
      "target": "main",
      "target_ref": "refs/heads/main"
    }
  ],
  "version": 1
}
