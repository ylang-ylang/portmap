{
  "manifest_version": 2,
  "name": "Portmap Connections",
  "version": "0.26.1",
  "description": "Route independent .portmap connections through direct TCP or pinned browser-side SSH using experimental networking capabilities.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox@portmap.ylang-ylang.github.io",
      "update_url": "https://github.com/ylang-ylang/portmap/releases/latest/download/firefox-experimental-updates.json",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity", "websiteContent"]
      }
    },
    "gecko_android": {}
  },
  "permissions": ["storage", "clipboardWrite", "proxy", "webRequest", "webRequestBlocking", "<all_urls>"],
  "experiment_apis": {
    "portmapTransport": {
      "schema": "transport/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "transport/api.js",
        "paths": [["portmapTransport"]]
      }
    }
  },
  "background": {
    "scripts": ["core.js", "managed-identity.js", "ssh/libssh2.js", "ssh/ssh.js", "proxy.js", "transports.js", "controller.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Portmap connections",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
}
