+#ifdef LIBSSH2_BROWSER_CALLBACK_IO
+/*
+ * Nightly probe private ABI. The caller has irreversibly closed its native
+ * socket and quiesced every JS operation before terminal destruction. No SSH
+ * message can be sent after this point. Incoming allocation ownership stays
+ * intact for session_free(), including partial handshake/open/read state.
+ */
+int _libssh2_browser_probe_abort(LIBSSH2_SESSION *session)
+{
+    if(!session)
+        return LIBSSH2_ERROR_BAD_USE;
+    /* This narrow bridge exposes direct-tcpip, never remote listeners. */
+    if(_libssh2_list_first(&session->listeners))
+        return _libssh2_error(session, LIBSSH2_ERROR_BAD_USE,
+                              "Browser probe cannot abort remote listeners");
+    session->socket_state = LIBSSH2_SOCKET_DISCONNECTED;
+    /* outbuf is inline, not allocated. Abandon the terminal packet's borrowed
+     * input pointer without changing any incoming heap-allocation fields. */
+    session->packet.odata = NULL;
+    session->packet.olen = 0;
+    session->packet.ototal_num = 0;
+    session->packet.osent = 0;
+    /* channel_free skips close I/O for DISCONNECTED, so pending outgoing
+     * WINDOW_ADJUST/OPEN/WRITE cannot cause send_existing's pointer EAGAIN. */
+    return session_free(session);
+}
+
+int _libssh2_browser_probe_read_cancel_safe(LIBSSH2_CHANNEL *channel)
+{
+    return channel->read_state == libssh2_NB_state_idle &&
+        channel->session->packet.olen == 0;
+}
